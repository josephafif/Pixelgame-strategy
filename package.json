{
  "name": "realmwright",
  "version": "0.1.0",
  "private": true,
  "description": "Realmwright: a real-time multiplayer kingdom strategy game with procedurally grown pixel-art settlements.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js --port 8080",
    "test": "node --test \"tests/*.test.js\"",
    "lint": "npx --yes eslint@10.1.0 .",
    "check": "npm run lint && npm test",
    "simulate": "node tools/simulate.mjs",
    "preview:world": "node tools/world-preview.mjs",
    "preview:settlement": "node tools/settlement-preview.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
